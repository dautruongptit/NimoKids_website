# Rendered by the nginx image at container start (envsubst): ${PORT} and ${API_UPSTREAM} come from the environment.
# nginx's own variables ($uri, $host, ...) are left alone because only defined environment variables are replaced.
server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Backend on the internal project network. The browser calls /api/... on this same origin, so no CORS is needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Cloudflare Tunnel terminates https, so keep the scheme it reports instead of nginx's own "http".
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Vite fingerprints the files it builds in /assets, so those can be cached for a year.
    # public/assets (design images) is copied to the same folder with its original names: keep its cache short.
    location /assets/ {
        expires 7d;
        try_files $uri =404;
    }

    # The shell must always be re-checked, otherwise users keep an old index.html pointing at deleted assets.
    location = /index.html {
        expires -1;
    }

    # Single-page app (react-router): unknown paths such as /topics or /quiz fall back to the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
